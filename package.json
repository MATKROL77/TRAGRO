{
  "name": "surco-configurador",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/postbuild.mjs",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "e2e": "playwright test --trace off",
    "textures": "node scripts/fetch-textures.mjs",
    "bench": "node bench/run.mjs",
    "textures:ktx2": "node scripts/textures-ktx2.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@react-three/postprocessing": "^2.19.1",
    "detect-gpu": "^5.0.70",
    "framer-motion": "^11.18.2",
    "jspdf": "^2.5.2",
    "maath": "^0.10.8",
    "postprocessing": "^6.36.4",
    "r3f-perf": "^7.2.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0",
    "three-stdlib": "^2.35.12",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@fontsource-variable/inter": "^5.1.0",
    "@fontsource-variable/manrope": "^5.1.0",
    "@playwright/test": "^1.63.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "jsdom": "^25.0.1",
    "ktx2-encoder": "^0.6.0",
    "sharp": "^0.35.5",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
