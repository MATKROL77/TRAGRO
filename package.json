{
  "name": "configurador-semirremolques",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node tests/e2e/run.cjs",
    "verificar": "npm run typecheck && npm run lint && npm run test && npm run build",
    "bench": "node bench/bench.cjs",
    "models:build": "node scripts/models-build.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/roboto-slab": "^5.3.0",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@react-three/postprocessing": "^2.19.1",
    "detect-gpu": "^5.0.70",
    "framer-motion": "^11.18.2",
    "jspdf": "^4.2.1",
    "lz-string": "^1.5.0",
    "postprocessing": "^6.39.6",
    "r3f-perf": "^7.2.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^6.4.6",
    "vitest": "^3.2.7"
  },
  "description": "Configurador 3D de semirremolques: demo comercial para fabricantes argentinos.",
  "engines": {
    "node": ">=20"
  }
